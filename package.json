{
  "name": "city-builders",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5185 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5185 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "simulate": "tsx scripts/simulate.ts",
    "lab": "tsx scripts/balance-lab.ts",
    "card-value": "tsx scripts/card-value.ts",
    "search": "tsx scripts/weight-search.ts",
    "audit-art": "node scripts/audit-art.mjs",
    "optimize-art": "node scripts/optimize-art.mjs",
    "audit-contrast": "node scripts/audit-contrast.mjs",
    "deploy": "npm test && npm run build && node scripts/deploy.mjs",
    "ladder": "tsx scripts/difficulty-ladder.ts",
    "audit-daily": "tsx scripts/audit-daily.ts"
  },
  "dependencies": {
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.0",
    "mpg123-decoder": "^1.0.3",
    "ogg-opus-decoder": "^1.7.5",
    "sharp": "^0.35.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
